
@using DyrenesBeskyttelse.Components.Models
@using DyrenesBeskyttelse.Models
@using DyrenesBeskyttelse.Services

@if (Report == null)
{
    <p class="text-muted">Ingen rapport.</p>
}
else
{
    @* US-8.8: Volunteers breaking the rule first,
       followed by those with the fewest attendances. *@

    var sorted = Report.GetSortedTimesheets();
    var antalBrudt = Report.CountBreakingRule();

    <p class="fw-semibold">
        @antalBrudt af @sorted.Count overholder ikke aktivitetsreglen
    </p>

    <table class="table table-striped align-middle admin-tabel">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Fremmøde</th>
                <th>Aktivitetsregel</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var t in sorted)
            {
                @* US-8.11: Only show the deactivation option
                   for volunteers who break the activity rule. *@

                <tr class="@(t.BreaksActivityRule ? "table-danger" : "table-success")">

                    <td>@t.Name</td>

                    <td>
                        @* 24/11: Samme tekst som i Excel-filen (ReportService.AttendanceText). *@
                        @ReportService.AttendanceText(t)
                    </td>

                    <td>
                        @(t.BreaksActivityRule
                            ? "overholdes ikke"
                            : "overholdes")

                        <span class="text-muted">
                            (@t.RuleText)
                        </span>
                    </td>

                    <td>
                        @if (t.BreaksActivityRule)
                        {
                            @if (t.IsActive)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-dark"
                                        disabled="@Busy"
                                        @onclick="() => OnDeactivate.InvokeAsync(t.VolunteerId)">

                                    Gør inaktiv

                                </button>
                            }
                            else
                            {
                                <span class="text-muted">Inaktiv</span>
                            }
                        }
                    </td>

                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired]
    public TimesheetReport? Report { get; set; }

    [Parameter]
    public EventCallback<long> OnDeactivate { get; set; }

    [Parameter]
    public bool Busy { get; set; }
}
