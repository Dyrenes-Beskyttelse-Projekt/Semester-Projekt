@page "/"
@using DyrenesBeskyttelse.Components.Services

@* OwningComponentBase giver komponenten sit eget DI-scope. Scoped services, der hentes fra
   ScopedServices, er derfor nye for denne komponent (ny AdminService og ny AppDbContext),
   og de bliver ryddet op (disposed), når man forlader siden. Brug IKKE @inject til services. *@
@inherits OwningComponentBase

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

@code
{
    private AdminService AdminService => ScopedServices.GetRequiredService<AdminService>();

    protected override async Task OnInitializedAsync()
    {
        var users = await AdminService.GetAdminsAsync();
    }
}
