@page "/"
@layout TabletLayout
@* Interaktiv, så knapperne virker (onclick). Uden den er siden kun statisk HTML. *@
@rendermode InteractiveServer
@using DyrenesBeskyttelse.Components.Models
@using DyrenesBeskyttelse.Components.Services
@using DyrenesBeskyttelse.Components.Shared
@using DyrenesBeskyttelse.Services

@* Tabletten på internatet (US-1, US-2, US-3). Intet login: Den frivillige trykker på sit navn
   og bekræfter i en dialogboks.

   OwningComponentBase giver komponenten sit eget DI-scope. Scoped services, der hentes fra
   ScopedServices, er derfor nye for denne komponent (ny VolunteerService og ny AppDbContext),
   og de bliver ryddet op (disposed), når man forlader siden. Brug IKKE @inject til services. *@
@inherits OwningComponentBase

<PageTitle>LogCat · Tjek ind og ud</PageTitle>

<h1 class="text-center mb-4">Tryk på dit navn</h1>

@if (message != null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") fs-4 text-center">@message</div>
}

@* US-1.1: Listen med en knap pr. frivillig. Store knapper og stor skrift (idé 2 i det virtuelle kort). *@
@if (volunteers == null)
{
    <p class="fs-4 text-center">Henter navne ...</p>
}
else if (volunteers.Count == 0)
{
    <p class="fs-4 text-center">Der er ingen aktive frivillige endnu.</p>
}
else
{
    <div class="name-grid">
        @foreach (var volunteer in volunteers)
        {
            @* US-3.2: Er man tjekket ind, er knappen grøn og viser tidspunktet. *@
            <button class="btn name-button @(volunteer.IsCheckedIn ? "btn-success" : "btn-outline-dark")"
                    disabled="@busy"
                    @onclick="() => Select(volunteer)">
                @volunteer.FullName
                @if (volunteer.CheckedInAt is DateTime checkedInAt)
                {
                    <span class="d-block fs-6">Tjekket ind kl. @checkedInAt.ToString("HH:mm")</span>
                }
            </button>
        }
    </div>
}

@* Jonas' bekræftelsesdialog (US-2.1 og US-2.2, Components/Shared) erstatter Julies midlertidige
   dialog. Den viser "Tjek ind" eller "Tjek ud" ud fra, om den frivillige er tjekket ind (US-3.2). *@
<Modal_CheckInDialogue IsOpen="selected != null"
                       Volunteer="selected"
                       Busy="busy"
                       OnClickCancel="Cancel"
                       OnClickConfirm="ConfirmAsync" />

@code {
    private VolunteerService VolunteerService => ScopedServices.GetRequiredService<VolunteerService>();

    private List<TabletVolunteer>? volunteers;
    private TabletVolunteer? selected;
    private string? message;
    private bool messageIsError;

    // Forhindrer dobbelttryk: AppDbContext kan kun udføre én forespørgsel ad gangen.
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // OVERLAP: GetTabletListAsync er Simons område (US-1.2). Hedder hans metode noget andet,
    // rettes kaldet her mandag, når vi har valgt én udgave.
    private async Task LoadAsync()
    {
        volunteers = await VolunteerService.GetTabletListAsync();
    }

    private void Select(TabletVolunteer volunteer)
    {
        message = null;
        selected = volunteer;
    }

    private void Cancel()
    {
        selected = null;
    }

    // Kaldes, når man trykker "Tjek ind" eller "Tjek ud" i dialogen. Er den frivillige allerede
    // tjekket ind, er det tjek ud (US-3.2), ellers tjek ind (US-2).
    private async Task ConfirmAsync()
    {
        if (selected == null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var volunteer = selected;
            bool checkOut = volunteer.CanCheckOut;
            // Valgt ved sammenlægningen: Servicemetoderne tager den frivilliges id og tjekker selv,
            // om tjek ind/ud er tilladt (acceptkriterierne i US-2 og US-3). Selve tjek ind sker med
            // Jonas' Volunteer.CheckIn().
            bool ok = checkOut
                ? await VolunteerService.CheckOutAsync(volunteer.Id)
                : await VolunteerService.CheckInAsync(volunteer.Id);

            // Tydelig kvittering (US-2). Fejler det, er listen ikke opdateret, fx fordi en anden
            // tablet har tjekket personen ind eller ud i mellemtiden.
            messageIsError = !ok;
            message = ok
                ? $"{volunteer.FullName}: Du er tjekket {(checkOut ? "ud" : "ind")} kl. {DateTime.Now:HH:mm}."
                : "Det lykkedes ikke. Listen er opdateret, så prøv igen.";

            selected = null;

            // Henter listen igen, så status og nye frivillige altid er opdateret.
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
