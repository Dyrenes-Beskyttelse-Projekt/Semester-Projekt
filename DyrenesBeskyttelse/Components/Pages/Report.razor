
@page "/report"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using DyrenesBeskyttelse.Components.Shared
@using DyrenesBeskyttelse.Components.Models
@using DyrenesBeskyttelse.Services
@using Microsoft.Extensions.DependencyInjection
@using DyrenesBeskyttelse.Components.Services

@inherits OwningComponentBase
@inject IJSRuntime Js

<PageTitle>LogCat · Månedsrapport</PageTitle>

<AdminOnly>

    @* 24/11: Danske tekster, så de passer til vejledningen (besluttet ved retrospective i sprint 2). *@
    <h1 class="text-center mb-4">Månedsrapport</h1>

    @* Rapporten vises kun, når den er hentet. *@
    @if (report != null)
    {
        <Overview Report="report"
                  OnDeactivate="DeactivateAsync"
                  Busy="busy" />

        <div class="text-center mt-4">
            <button type="button"
                    class="btn btn-success btn-lg report-button"
                    @onclick="ExportReportAsync"
                    disabled="@busy">

                @(busy ? "Vent venligst ..." : "Download som Excel")

            </button>
        </div>
    }

    <div class="report-container">

        <EditForm Model="@reportRequest"
                  OnValidSubmit="ExtractReportAsync">

            <div class="mb-4">
                <label class="form-label fs-4" for="selectedMonth">
                    Vælg måned
                </label>

                <InputSelect id="selectedMonth"
                             class="form-select form-select-lg"
                             @bind-Value="selectedMonth"
                             disabled="@busy">

                    <option value="">-- Vælg en måned --</option>

                    @foreach (var month in completedMonths)
                    {
                        <option value="@month.Key">
                            @month.Name
                        </option>
                    }

                </InputSelect>
            </div>

            <div class="text-center mt-5">
                <button type="submit"
                        class="btn btn-primary btn-lg report-button"
                        disabled="@(busy || string.IsNullOrEmpty(selectedMonth) || completedMonths.Count == 0)">

                    @(busy ? "Henter rapporten ..." : "Vis rapport")

                </button>
            </div>

        </EditForm>

        @if (message != null)
        {
            <div class="alert @(messageIsError ? "alert-danger" : "alert-success") fs-4 text-center mt-4">
                @message
            </div>
        }

    </div>

</AdminOnly>

@code {

    private AdminService AdminService =>
        ScopedServices.GetRequiredService<AdminService>();

    private ReportService ReportService =>
        ScopedServices.GetRequiredService<ReportService>();

    private ReportRequest reportRequest = new();

    private TimesheetReport? report;

    private string? message;
    private bool messageIsError;
    private bool busy;

    // 24/11 (US-8.1): De seneste 12 afsluttede måneder, nyeste øverst (se ReportService.GetCompletedMonths).
    private List<MonthOption> completedMonths = new();

    // Den valgte måned som "yyyy-MM". Sidste måned er valgt på forhånd.
    private string? selectedMonth;

    protected override void OnInitialized()
    {
        var dansk = new System.Globalization.CultureInfo("da-DK");

        completedMonths = ReportService.GetCompletedMonths(DateTime.Today)
            .Select(startDate => new MonthOption
            {
                Key = startDate.ToString("yyyy-MM"),
                Name = startDate.ToString("MMMM yyyy", dansk),
                StartDate = startDate,
                EndDate = startDate.AddMonths(1).AddDays(-1)
            })
            .ToList();

        selectedMonth = completedMonths.FirstOrDefault()?.Key;
    }

    private async Task ExtractReportAsync()
    {
        if (busy)
        {
            return;
        }

        message = null;
        messageIsError = false;

        if (string.IsNullOrEmpty(selectedMonth))
        {
            messageIsError = true;
            message = "Vælg en måned.";
            return;
        }

        // Resolve the selected month into its date range.
        var selected = completedMonths
            .FirstOrDefault(m => m.Key == selectedMonth);

        if (selected == null)
        {
            messageIsError = true;
            message = "Den valgte måned kan ikke vælges.";
            return;
        }

        reportRequest.StartDate = selected.StartDate;
        reportRequest.EndDate = selected.EndDate;

        busy = true;

        try
        {
            report = await ReportService.GetReport(
                reportRequest.StartDate,
                reportRequest.EndDate
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Report extraction error: {ex}");

            messageIsError = true;
            message = "Der skete en fejl, da rapporten skulle hentes.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeactivateAsync(long volunteerId)
    {
        if (busy || report == null)
        {
            return;
        }

        busy = true;
        message = null;

        try
        {
            await AdminService.SetVolunteerActiveAsync(volunteerId, false);

            // Reload the report for the same period so the row
            // reflects the volunteer's updated status.
            report = await ReportService.GetReport(
                report.StartDate,
                report.EndDate
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Volunteer deactivation error: {ex}");

            messageIsError = true;
            message = "Der skete en fejl, da den frivillige skulle gøres inaktiv.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ExportReportAsync()
    {
        if (report == null || busy)
        {
            return;
        }

        busy = true;
        message = null;
        messageIsError = false;

        try
        {
            // Generate the Excel file using ClosedXML.
            byte[] excelFile = ReportService.GenerateExcelReport(report);

            if (excelFile.Length == 0)
            {
                throw new InvalidOperationException(
                    "Excel-filen er tom."
                );
            }

            // Generate filename based on the report period.
            string fileName =
                $"Maanedsrapport_{report.StartDate:yyyy-MM}.xlsx";

            // Trigger the browser download.
            await Js.InvokeVoidAsync(
                "downloadFile",
                fileName,
                Convert.ToBase64String(excelFile)
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Excel export error: {ex}");

            messageIsError = true;
            message = "Der skete en fejl, da Excel-filen skulle laves.";
        }
        finally
        {
            busy = false;
        }
    }

    public class MonthOption
    {
        public string Key { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public DateTime StartDate { get; set; }

        public DateTime EndDate { get; set; }
    }

    public class ReportRequest
    {
        public DateTime StartDate { get; set; }

        public DateTime EndDate { get; set; }
    }
}

<style>
    .report-container {
        max-width: 650px;
        margin: 0 auto;
        padding: 20px;
    }

    .report-button {
        min-width: 250px;
        min-height: 65px;
        font-size: 1.5rem;
    }

    .form-control,
    .form-select {
        min-height: 60px;
        font-size: 1.25rem;
    }
</style>
