
@inject IJSRuntime Js
@page "/report"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using DyrenesBeskyttelse.Components.Shared
@using DyrenesBeskyttelse.Components.Models
@using DyrenesBeskyttelse.Services
@using Microsoft.Extensions.DependencyInjection
@using DyrenesBeskyttelse.Components.Services

@inherits OwningComponentBase

<PageTitle>LogCat · Extract Report</PageTitle>

<AdminOnly>

    <h1 class="text-center mb-4">Extract Report</h1>

    @if (report != null)
    {
        <Overview Report="report" />

        <div class="text-center mt-4">
            <button type="button"
                    class="btn btn-success btn-lg report-button"
                    @onclick="ExportReportAsync"
                    disabled="@busy">

                @(busy ? "Processing..." : "Download Excel")
            </button>
        </div>
    }

    <div class="report-container">

        <EditForm Model="@reportRequest"
                  OnValidSubmit="ExtractReportAsync">

            @* Your existing date inputs and button *@

        </EditForm>

        @* Your existing feedback message *@

    </div>
}
else
{
    <Overview Report="report" OnDeactivate="DeactivateAsync" Busy="busy" />
}

<div class="report-container">

    <EditForm Model="@reportRequest" OnValidSubmit="ExtractReportAsync">

        <div class="mb-4">
            <label class="form-label fs-4" for="startDate">
                Start Date
            </label>

            <InputDate id="startDate"
                       class="form-control form-control-lg"
                       @bind-Value="reportRequest.StartDate" />
        </div>

        <div class="mb-4">
            <label class="form-label fs-4" for="endDate">
                End Date
            </label>
            <div class="mb-4">
                <label class="form-label fs-4" for="selectedMonth">
                    Select Month
                </label>

                <InputSelect id="selectedMonth"
                             class="form-select form-select-lg"
                             @bind-Value="selectedMonth"
                             disabled="@busy">

                    <option value="">-- Select a month --</option>

                    @foreach (var month in completedMonths)
                    {
                        <option value="@month.Month">
                            @month.Name
                        </option>
                    }

                </InputSelect>
            </div>

            <div class="text-center mt-5">
                <button type="submit"
                        class="btn btn-primary btn-lg report-button"
                        disabled="@(busy || selectedMonth == null || completedMonths.Count == 0)">

                    @(busy ? "Extracting..." : "Extract Report")

                </button>
            </div>

        </EditForm>

        @if (message != null)
        {
            <div class="alert @(messageIsError ? "alert-danger" : "alert-success")
                        fs-4 text-center mt-4">
                @message
            </div>
        }

    </div>

</AdminOnly>

@code {
    
    private AdminService AdminService =>
        ScopedServices.GetRequiredService<AdminService>();

    private async Task DeactivateAsync(long volunteerId)
    {
        if (busy || report == null) return;
        busy = true;

        try
        {
            await AdminService.SetVolunteerActiveAsync(volunteerId, false);

            // Hent rapporten igen for samme periode, så rækken viser "Inaktiv"
            report = await ReportService.GetReport(report.StartDate, report.EndDate);
        }
        finally
        {
            busy = false;
        }
    }

    // Retrieves ReportService from this component's DI scope.
    private ReportService ReportService =>
        ScopedServices.GetRequiredService<ReportService>();

    private ReportRequest reportRequest = new();

    private TimesheetReport? report;

    private string? message;
    private bool messageIsError;
    private bool busy;

    // Available completed months.
    private List<MonthOption> completedMonths = new();

    // Currently selected month.
    private int? selectedMonth;

    protected override void OnInitialized()
    {
        var today = DateTime.Today;

        completedMonths = Enumerable.Range(1, 12)
            .Where(month => month < today.Month)
            .Select(month =>
            {
                var startDate = new DateTime(today.Year, month, 1);

                return new MonthOption
                {
                    Month = month,
                    Name = startDate.ToString("MMMM yyyy"),
                    StartDate = startDate,
                    EndDate = startDate.AddMonths(1).AddDays(-1)
                };
            })
            .ToList();
    }

    private async Task ExtractReportAsync()
    {
        if (busy)
        {
            return;
        }

        message = null;
        messageIsError = false;

        if (selectedMonth == null)
        {
            messageIsError = true;
            message = "Please select a month.";
            return;
        }

        // Resolve the selected month into its date range.
        var selected = completedMonths
            .FirstOrDefault(m => m.Month == selectedMonth);

        if (selected == null)
        {
            messageIsError = true;
            message = "The selected month is not available.";
            return;
        }

        reportRequest.StartDate = selected.StartDate;
        reportRequest.EndDate = selected.EndDate;

        busy = true;

        try
        {
            // Generate the report using the selected month's dates.
            report = await ReportService.GetReport(
                reportRequest.StartDate,
                reportRequest.EndDate
            );
        }
        catch (Exception)
        {
            messageIsError = true;
            message = "An error occurred while extracting the report.";
        }
        finally
        {
            busy = false;
        }
    }
    
    private async Task ExportReportAsync()
    {
        if (report == null || busy)
        {
            return;
        }

        busy = true;

        try
        {
            // Generate Excel file
            byte[] excelFile = ReportService.GenerateExcelReport(report);

            // Generate filename based on report period
            string fileName =
                $"TimesheetReport_{report.StartDate:yyyy-MM}.xlsx";

            // Trigger browser download
            await Js.InvokeVoidAsync(
                "downloadFile",
                fileName,
                Convert.ToBase64String(excelFile)
            );
        }
        catch (Exception)
        {
            messageIsError = true;
            message = "An error occurred while generating the Excel file.";
        }
        finally
        {
            busy = false;
        }
    }

    public class MonthOption
    {
        public int Month { get; set; }

        public string Name { get; set; } = string.Empty;

        public DateTime StartDate { get; set; }

        public DateTime EndDate { get; set; }
    }

    public class ReportRequest
    {
        public DateTime StartDate { get; set; }

        public DateTime EndDate { get; set; }
    }
}

<style>
    .report-container {
        max-width: 650px;
        margin: 0 auto;
        padding: 20px;
    }

    .report-button {
        min-width: 250px;
        min-height: 65px;
        font-size: 1.5rem;
    }

    .form-control,
    .form-select {
        min-height: 60px;
        font-size: 1.25rem;
    }
</style>

