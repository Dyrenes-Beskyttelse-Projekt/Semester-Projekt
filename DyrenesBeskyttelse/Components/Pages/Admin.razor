@implements IDisposable
@using DyrenesBeskyttelse.Components.Services
@using DyrenesBeskyttelse.Services
@inject AdminSession Session
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="admin">Administration</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (Session.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">Oversigt</NavLink>
            </div>
            
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="frivillige">Frivillig </NavLink>
            </div>
            
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="opret-frivillig">Opret frivillig</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="registrer-papirliste">Papirliste</NavLink>
            </div>
            
            <div class="nav-item px-3">
                <button class="nav-link" @onclick="LogUd">Log ud (@Session.FullName)</button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">Log ind</NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnChange += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Session.RestoreAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void LogUd()
    {
        Session.SignOut();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Session.OnChange -= OnChanged;
    }
}