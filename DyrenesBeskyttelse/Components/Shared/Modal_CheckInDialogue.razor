@using DyrenesBeskyttelse.Components.Models
@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @Volunteer?.GetFullName()
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="OnClickCancel"></button>
                </div>
                <div class="modal-body">
                    Vil du tjekke ind?
                </div>
                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-auto">
                    <button type="button" class="btn btn-danger" @onclick="OnClickCancel">Fortryd</button>
                    <button type="button" class="btn btn-success" @onclick="OnClickConfirm">Bekræft</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Volunteer? Volunteer { get; set; }


    [Parameter] [EditorRequired] public EventCallback OnClickCancel { get; set; }
    [Parameter] [EditorRequired] public EventCallback OnClickConfirm { get; set; }

}