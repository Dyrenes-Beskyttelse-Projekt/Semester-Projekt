@inherits LayoutComponentBase
@implements IDisposable
@using DyrenesBeskyttelse.Services
@inject AdminSession Session
@inject NavigationManager Nav

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        @* Linket "About" fra Blazor-skabelonen (til Microsofts dokumentation) er fjernet.
           18/11 (US-10.3): Når man er logget ind, står "Logget ind som ..." og knappen "Log ud" her
           oppe i højre hjørne i stedet for i menuen til venstre. *@
        <div class="top-row px-4">
            @if (Session.IsLoggedIn)
            {
                <span class="logget-ind">Logget ind som <strong>@Session.FullName</strong></span>
                <button class="log-ud-knap" @onclick="LogUd">Log ud</button>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    // Bjælken opdateres, når man logger ind eller ud, eller når et husket login hentes (F5).
    protected override void OnInitialized()
    {
        Session.OnChange += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void LogUd()
    {
        Session.SignOut();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Session.OnChange -= OnChanged;
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>