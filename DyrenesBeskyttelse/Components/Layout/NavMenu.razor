@implements IDisposable
@using DyrenesBeskyttelse.Components.Services
@using DyrenesBeskyttelse.Services
@inject AdminSession Session
@inject NavigationManager Nav

@* 18/11 (US-7.3, Saed): Den eneste menu. Saeds AdminNavs/AdminLayouts og Admin.razor er slettet,
   så administrationen kun har én menu. Administrationslinks og "Log ud" vises kun, når man er logget ind. *@
<div class="top-row ps-3 navbar">
    <div class="container-fluid">
        <a class="navbar-brand" href="">DyrenesBeskyttelse</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        
        <div class="nav-item px-3">
            @if (Session.IsLoggedIn)
            {
                <NavLink class="nav-link" href="admin">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Admin
                </NavLink>
            }
            else
            {
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            }
        </div>
        

        @if (Session.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="opret-frivillig">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Opret frivillig
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="report">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Månedsrapport
                </NavLink>
            </div>

            @* "Registrér fremmøde fra papirliste" (US-10.1) tilføjes her, når siden er lavet.
               (Linket til registrer-papirliste er fjernet, fordi siden ikke findes endnu.) *@

            <div class="nav-item px-3">
                <button class="nav-link" @onclick="LogUd">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Log ud (@Session.FullName)
                </button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Login
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnChange += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void LogUd()
    {
        Session.SignOut();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Session.OnChange -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}